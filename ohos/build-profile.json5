{
  "app": {
    "signingConfigs": [{
      "name": "default",
      "material": {
        "certpath": "signing/cert.cer",
        "storePassword": "***",
        "keyAlias": "YourTJCourse",
        "keyPassword": "***",
        "profile": "signing/ProvisionProfile.p7b",
        "signAlg": "SHA256withECDSA",
        "storeFile": "signing/keystore.p12"
      }
    }],
    "products": [{
      "name": "default",
      "signingConfig": "default",
      "compatibleSdkVersion": "5.0.0(11)",
      "runtimeOS": "HarmonyOS"
    }],
    "buildModeSet": [{
      "name": "debug"
    }, {
      "name": "profile"
    }, {
      "name": "release"
    }]
  },
  "modules": [{
    "name": "entry",
    "srcPath": "./entry",
    "targets": [{
      "name": "default",
      "applyToProducts": ["default"]
    }]
  }]
}
